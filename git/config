[core]
  editor = nvim
  ignorecase = false
	autocrlf = input

[diff]
    external = difft

[user]
  name = Yanguk
	email = yanguk@duck.com
  signingkey = 4393B4559800E556EC978C9C879056D45517B74F

[commit]
  gpgsign = true

[pull]
  ff = only

[push]
  default = current
  autoSetupRemote = true

[include]
	path = ~/.config/delta/themes/catppuccin.gitconfig

[merge]
  conflictstyle = zdiff3

[diff]
  colorMoved = default
  algorithm = histogram

[branch]
	sort = committerdate
[alias]
	gone = ! git fetch -p && git for-each-ref --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" {print $1}' | xargs -r git branch -D

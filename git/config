[core]
  editor = nvim
  ignorecase = false
	autocrlf = input
  pager = ~/.config/delta/delta-auto

[interactive]
  diffFilter = ~/.config/delta/delta-auto --color-only

[delta]
  navigate = true  # use n and N to move between diff sections
  side-by-side = true        # 좌우 분할로 이전/이후 코드 비교
  line-numbers = true        # 라인 번호 표시

[user]
  name = Yanguk
  email = yanguk-heo@daekyo.co.kr

  signingkey = 4393B4559800E556EC978C9C879056D45517B74F

[commit]
  gpgsign = true

[pull]
  ff = only

[push]
  default = current
  autoSetupRemote = true

[include]
	path = ~/.config/delta/themes/catppuccin.gitconfig

[merge]
  conflictstyle = zdiff3

[diff]
  colorMoved = default
  algorithm = histogram

[branch]
	sort = committerdate
[alias]
	gone = ! git fetch -p && git for-each-ref --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" {print $1}' | xargs -r git branch -D
